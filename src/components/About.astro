---
import SectionHeading from './SectionHeading.astro';
---

<section id="about" class="section about" aria-labelledby="about-title" data-reveal>
	<div class="container about__layout">
		<div class="about__heading">
			<SectionHeading number="01" title="About" />
		</div>

		<div class="about__body">
			<div class="about__copy">
				<p id="about-title" class="about__intro">
					I’m a B.Tech graduate in Artificial Intelligence and Data Science from Vishwakarma Institute of Information Technology, Pune, focused on building practical AI/ML and GenAI-powered software systems.
				</p>
				<p>
					My work spans LLM and RAG applications, agentic systems, computer vision, and backend engineering. I focus on turning model capabilities into dependable intelligent systems with clear product value.
				</p>
			</div>

			<dl class="about__details">
				<div>
					<dt>Location</dt>
					<dd>Pune, India</dd>
				</div>
				<div>
					<dt>Education</dt>
					<dd>B.Tech — AI &amp; Data Science</dd>
				</div>
				<div>
					<dt>Focus</dt>
					<dd>AI / ML / GenAI</dd>
				</div>
				<div>
					<dt>Interests</dt>
					<dd>Intelligent Systems, Chess</dd>
				</div>
			</dl>
		</div>
	</div>
</section>

<style>
	.about__layout {
		display: grid;
		grid-template-columns: minmax(14rem, 0.43fr) 1fr;
		gap: clamp(3rem, 8vw, 8rem);
	}

	.about__body,
	.about__copy {
		display: grid;
		gap: 1.5rem;
	}

	.about__intro {
		max-width: 38ch;
		color: var(--text-primary);
		font-size: clamp(1.25rem, 2.2vw, 1.65rem);
		line-height: 1.3;
		text-wrap: balance;
	}

	.about__details {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0;
		margin: clamp(1rem, 3vw, 2rem) 0 0;
		border-top: 1px solid var(--border);
	}

	.about__details div {
		display: grid;
		gap: 0.35rem;
		padding-block: 1rem;
		border-bottom: 1px solid var(--border);
	}

	.about__details div:nth-child(odd) {
		padding-right: 1rem;
	}

	.about__details div:nth-child(even) {
		padding-left: 1rem;
		border-left: 1px solid var(--border);
	}

	.about__details dt {
		color: var(--text-muted);
		font-family: var(--font-mono);
		font-size: 0.7rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.about__details dd {
		margin: 0;
		color: var(--text-primary);
		font-size: 0.9rem;
	}

	@media (max-width: 800px) {
		.about__layout {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 480px) {
		.about__details {
			grid-template-columns: 1fr;
		}

		.about__details div:nth-child(odd),
		.about__details div:nth-child(even) {
			padding-inline: 0;
		}

		.about__details div:nth-child(even) {
			border-left: 0;
		}
	}
</style>
