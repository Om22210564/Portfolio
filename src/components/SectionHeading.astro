---
interface Props {
	number: string;
	title: string;
	subtitle?: string;
}

const { number, title, subtitle } = Astro.props;
---

<div class="section-heading">
	<p class="section-heading__number" aria-hidden="true">{number}</p>
	<div class="section-heading__content">
		<h2>{title}</h2>
		{subtitle && <p>{subtitle}</p>}
	</div>
</div>

<style>
	.section-heading {
		display: grid;
		grid-template-columns: minmax(3rem, 0.3fr) 1fr;
		gap: 1.25rem;
		padding-bottom: clamp(2rem, 4vw, 3.5rem);
		border-bottom: 1px solid var(--border);
	}

	.section-heading__number {
		padding-top: 0.35rem;
		color: var(--text-muted);
		font-family: var(--font-mono);
		font-size: 0.75rem;
		letter-spacing: 0.08em;
	}

	.section-heading__content {
		display: grid;
		gap: 0.75rem;
	}

	.section-heading h2 {
		margin: 0;
		font-size: clamp(2rem, 4vw, 3.5rem);
		text-transform: uppercase;
	}

	.section-heading__content p {
		font-size: 0.95rem;
	}

	@media (max-width: 620px) {
		.section-heading {
			grid-template-columns: 1fr;
			gap: 0.75rem;
		}

		.section-heading__number {
			padding-top: 0;
		}
	}
</style>
