---
import { skillCategories } from '../data/skills';
import SectionHeading from './SectionHeading.astro';
---

<section id="skills" class="section skills" aria-label="Skills" data-reveal>
	<div class="container skills__layout">
		<div class="skills__heading"><SectionHeading number="04" title="Skills" /></div>
		<div class="skills__groups">
			{skillCategories.map((category) => (
				<section class="skills__group" aria-labelledby={`skills-${category.name.replaceAll(/[^a-zA-Z0-9]+/g, '-').toLowerCase()}`}>
					<h3 id={`skills-${category.name.replaceAll(/[^a-zA-Z0-9]+/g, '-').toLowerCase()}`}>{category.name}</h3>
					<ul>
						{category.skills.map((skill) => <li>{skill}</li>)}
					</ul>
				</section>
			))}
		</div>
	</div>
</section>

<style>
	.skills__layout { display: grid; grid-template-columns: minmax(14rem, 0.43fr) 1fr; gap: clamp(3rem, 8vw, 8rem); }
	.skills__groups { border-top: 1px solid var(--border); }
	.skills__group { display: grid; grid-template-columns: minmax(9rem, 0.32fr) 1fr; gap: 1.5rem; padding-block: 1.5rem; border-bottom: 1px solid var(--border); }
	.skills__group h3 { margin: 0; color: var(--text-primary); font-family: var(--font-mono); font-size: 0.75rem; font-weight: 500; letter-spacing: 0.06em; line-height: 1.5; text-transform: uppercase; }
	.skills__group ul { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 0; padding: 0; list-style: none; }
	.skills__group li { padding: 0.4rem 0.6rem; border: 1px solid var(--border); border-radius: 0.4rem; color: var(--text-secondary); font-family: var(--font-mono); font-size: 0.72rem; line-height: 1.2; }
	@media (max-width: 800px) { .skills__layout { grid-template-columns: 1fr; } }
	@media (max-width: 520px) { .skills__group { grid-template-columns: 1fr; gap: 0.9rem; } }
</style>
